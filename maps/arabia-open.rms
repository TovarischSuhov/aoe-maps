		#const HUNTABLE_GROUPS 0
		#const HUNTABLE_DISTANCE rnd(20,28)

		start_random
			percent_chance 20
				#const HUNTABLE_ADDITIONAL_COUNT 2
			percent_chance 45
				#const HUNTABLE_ADDITIONAL_COUNT 3
			percent_chance 35
				#const HUNTABLE_ADDITIONAL_COUNT 4
		end_random

		/* arabia-open: доп. олени — 6 групп/игрок (было 1) */
		#const HUNTABLE_ADDITIONAL_GROUPS 6
		#const HUNTABLE_ADDITIONAL_DISTANCE rnd(36,40)

		start_random
			percent_chance 20
				#const HUNTABLE_SMALL_COUNT 6
			percent_chance 45
				#const HUNTABLE_SMALL_COUNT 7
			percent_chance 35
				#const HUNTABLE_SMALL_COUNT 8
		end_random

		/* arabia-open: базовой мелочи у ТЦ нет — только в рассыпи */
		#const HUNTABLE_SMALL_GROUPS 0
		#const HUNTABLE_SMALL_DISTANCE 18

		start_random
			percent_chance 20
				#const HUNTABLE_SMALL_ADDITIONAL_COUNT 6
			percent_chance 45
				#const HUNTABLE_SMALL_ADDITIONAL_COUNT 7
			percent_chance 35
				#const HUNTABLE_SMALL_ADDITIONAL_COUNT 8
		end_random

		/* arabia-open: доп. мелочь — 5 групп/игрок (было 1) */
		#const HUNTABLE_SMALL_ADDITIONAL_GROUPS 5
		#const HUNTABLE_SMALL_ADDITIONAL_DISTANCE rnd(36,40)

		/* arabia-open: кучи дичи не лепятся — свой тип 20 → 28 (спейсинг),
		   олени↔мелочь 8 → 16 (радиус спейсер-зоны, через avoid_actor_area) */
		#const HUNTABLE_ADDITIONAL_SPACING 28
		#const HUNTABLE_SMALL_ADDITIONAL_SPACING 28
		#const HUNTABLE_ADDITIONAL_ACTOR_AREA_RADIUS 16
		#const HUNTABLE_SMALL_ADDITIONAL_ACTOR_AREA_RADIUS 16

		/* ==== begin inlined includes/huntable.inc ==== */
