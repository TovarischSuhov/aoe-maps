create_object RELIC /* Player Relic */
{
	set_place_for_every_player
	set_gaia_object_only
	
	if MAPSIZE_TINY
		number_of_objects 2
	elseif MAPSIZE_SMALL
		number_of_objects 2
	elseif MAPSIZE_MONSTROUS
		number_of_objects 2
	elseif MAPSIZE_LUDICROUS
		number_of_objects 2
	else
		number_of_objects 1
	endif

	min_distance_to_players RELIC_DISTANCE
	temp_min_distance_group_placement RELIC_SPACING
	find_closest

	set_circular_placement
	require_path

	enable_tile_shuffling



	min_distance_group_placement 1
	max_distance_to_other_zones RELIC_ZONE_DISTANCE
	avoid_forest_zone RELIC_FOREST_DISTANCE
	avoid_cliff_zone RELIC_CLIFF_DISTANCE
	min_distance_to_map_edge (8 * MAPSCALE_SIDE)

	actor_area 11500
	actor_area_radius RELIC_SPACING

	avoid_actor_area 1500 /* Relic */
	avoid_actor_area 11500 /* Central Relic - Spacer */
	avoid_actor_area 10102 /* Minimum Primary Forage Bush Distance */
	avoid_actor_area 10202 /* Minimum Primary Gold Distance */
	avoid_actor_area 10302 /* Minimum Primary Stone Distance */





}
