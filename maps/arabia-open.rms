	#define PLAYER_COUNT_EVEN
elseif 7_PLAYER_GAME
	#const PLAYER_COUNT 7
	#define PLAYER_COUNT_ODD
elseif 8_PLAYER_GAME
	#const PLAYER_COUNT 8
	#define PLAYER_COUNT_EVEN
endif

