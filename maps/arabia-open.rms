/* arabia-open.rms — плоская (self-contained) основа.
 *
 * Сгенерировано скриптом развёртывания include'ов из официальной
 * Arabia.rms (AoE2: DE, v3.3) + includes/*.inc: все #include_drs
 * инлайнены на месте (повторы отброшены), чтобы карта была одним
 * файлом и её целиком видел aoe2-lsp.
 *
 * Источник (не коммитится): refs/game/ — снимок установки AoE2:DE,
 * resources/_common/drs/gamedata_x2/. Официальный контент © Forgotten
 * Empires / Microsoft — переизвлечь: scripts/corpus-official.sh (aoe-rms-lsp).
 *
 * Чистка (проход 1, 2026-10-17): ветки режимов Empire Wars и Escalation
 * удалены — в обычной партии (случайная карта) их константы не определены,
 * т.е. код был недостижим и на стандартную игру не влияет.
 *
 * Чистка (проход 2, 2026-10-17): свёрнуты блоки под условием TOWN_HERDABLE —
 * константа определялась только внутри удалённой ветки Empire Wars, теперь
 * всегда ложна; на стандартную игру правка не влияет.
 *
 * Чистка (проход 3, 2026-10-17): удалён режим Nomad. Корень — закомментированное
 * `#define NOMAD_MAP`, поэтому весь номад-код был недостижим. Свёрнуты блоки под
 * NOMAD_MAP/START/TREATY/CASTLE/SCATTERED/HERDABLE/UNIT и снят блок настроек Nomad.
 *
 * Чистка (проход 4, 2026-10-17): сняты определения-сироты — константы, все
 * ссылки на которые ушли вместе с удалёнными ветками (BARRACKS, HOUSE, MILL,
 * FARM, DOCK, MINING_CAMP, LUMBER_CAMP, BLACKSMITH, FISHING_SHIP, LAZY_MALE/
 * FEMALE, LUREABLE_DEDUCTION, RESOURCE_SPACING_FAR, REVEALER_TEMPORARY_LARGE,
 * NOMAD_SCOUT). Строки, где эти символы не встречаются нигде более.
 *
 * Чистка (проход 5, 2026-10-17): сняты мёртвые биомы. Тема-рандомайзер
 * определяет лишь 11 из 22 используемых биомов базового шаблона
 * (percent_chance N #define BIOME в start_random), поэтому ветки остальных
 * 11 биомов недостижимы: NEARCTIC_TUNDRA/TAIGA/DESERT, NEOTROPICAL_DESERT,
 * PALAEARCTIC_ASIA_TAIGA/DESERT, AFROTROPICAL_DESERT, AUSTRALASIAN_TROPICAL/
 * DESERT, OCEANIAN_TROPICAL, ANTARCTIC_TUNDRA. Вместе с ними ушли осиротевшие
 * `#const CIVILISATION_*` (BULGARIANS, TATARS, CUMANS, JURCHENS, HUNS, MONGOLS),
 * использовавшиеся только в этих ветках. На стандартную игру правка не влияет.
 *
 * Чистка (проход 6, 2026-10-17): сняты мёртвые селекторы-хуки
 * FOREST_INDIVIDUAL_ENABLE, WALL_ENABLE, HERDABLE_GROUP_SIZE_* и
 * HERDABLE_GROUP_COUNT_*.
 * Структура всюду `if <хук> <вариант-с-хуком> else <живой вариант> endif`,
 * а хуки в плоской карте не определены → живой `else`; свёрнуто 32 конструкции
 * (29 else-инлайнов, 3 удалены целиком), −1596 строк. Вместе с ними ушли 29
 * осиротевших определений (FOREST_COUNT_*_TILES/CLUMPS/CLUMPING/SPACING/
 * AVOIDANCE_*, WALL_TYPE/RADIUS/ACTOR_AREA_RADIUS, PLACEMENT_BLOCKER,
 * PLACEHOLDER_GENERIC_TILE). Ресурсные CAA/placement/terrain-хуки НЕ тронуты —
 * они понадобятся в переработке ресурсов.
 *
 * Чистка (проход 7, 2026-10-17): снято ВСЁ оставшееся мёртвое — 348 условий
 * (331 + 17 вложенных, всплывших каскадом), 450 мест. Это per-object точки
 * расширения DE (CAA_A..E, TERRAIN, PLACEMENT_ID, IGNORE, ZONE_AVOIDANCE и
 * водные/животные семейства), отключённые наборы ресурсов (FORAGE_BUSH_
 * SECONDARY/TERTIARY/ADDITIONAL, STONE_TERTIARY, STRAGGLER_COASTAL), режимные
 * селекторы (REGICIDE_*, RELIC_TYPE_*, CAPTURE_*) и управляющие переключатели
 * (DEBUG_MODE, LEGACY_CODE, TERRAIN_DEBUGGING, FLAT_ONLY, SPECIFIC_HEIGHT,
 * TEAMS_CONNECTED, GENERATE_PONDS, MULTI_START и пр.). Итог: −2065 строк
 * свёрток (364 конструкции: 49 else-инлайнов, 309 удалены целиком) плюс 52
 * осиротевших определения; файл — 11 472 строки. Встроенных движковых условий
 * (в т.ч. KING_OF_THE_HILL) не трогали — они всегда истинны/управляются лобби.
 * Точки расширения при необходимости возвращаются из исходного flat_full.rms.
 *
 * Переработка ресурсов (проход 8, 2026-10-17, по ТЗ open-Arabia): карта должна
 * играться открыто — за счёт обилия еды/золота/камня без тиров.
 *   - дичь: снят 50/50 (GAME_HUNTABLE/GAME_CHICKEN) — олени и мелкая дичь
 *     (куры/заяц/фазан) на карте всегда; базовых групп у ТЦ нет
 *     (HUNTABLE_GROUPS и HUNTABLE_SMALL_GROUPS → 0) — вся дичь только в
 *     раскиданных кучах ≥36 тайлов;
 *   - золото/камень: сняты тиры GOLD_SECONDARY, GOLD_TERTIARY и
 *     STONE_SECONDARY (блоки и их #define), −299 строк; раскиданные кучи
 *     даёт механизм *_ADDITIONAL;
 *   - доп. кучи на игрока: золото 4 группы, камень 3, олени 6, мелочь 5
 *     (было по 1); дичь раздвинута — кучи своего типа spacing 28 (было 20),
 *     олени↔мелочь радиус спейсер-зоны 16 (было 8); дистанции от ТЦ по ТЗ;
 *   - овцы: снята доп. отара (HERDABLE_GROUPS 2→0) — остаётся одна.
 * Файл — 11 207 строк.
 */

/*

	Arabia by Forgotten Empires

	Created: 14/09/2021
	Updated: 10/12/2025
	
	Version: 3.3

*/

#const MAPSCALE_MODIFIER 1
/* ==== begin inlined includes/scaling.inc ==== */
#const MAPSIDE_MINI 80
#const MAPSIDE_BASE 100
#const MAPSIDE_TINY 120
#const MAPSIDE_SMALL 144
#const MAPSIDE_MEDIUM 168
#const MAPSIDE_NORMAL 200
#const MAPSIDE_LARGE 220
#const MAPSIDE_HUGE 240
#const MAPSIDE_GIANT 252
#const MAPSIDE_MASSIVE 276
#const MAPSIDE_ENORMOUS 300
#const MAPSIDE_COLOSSAL 320
#const MAPSIDE_INCREDIBLE 360
#const MAPSIDE_MONSTREOUS 400
#const MAPSIDE_LUDICROUS 480

/* Side Scaling */

if MAPSIZE_MINI
	#const MAPSIZE_SIDE (MAPSIDE_MINI * MAPSCALE_MODIFIER)
elseif MAPSIZE_TINY
	#const MAPSIZE_SIDE (MAPSIDE_TINY * MAPSCALE_MODIFIER)
elseif MAPSIZE_SMALL
	#const MAPSIZE_SIDE (MAPSIDE_SMALL * MAPSCALE_MODIFIER)
elseif MAPSIZE_MEDIUM
	#const MAPSIZE_SIDE (MAPSIDE_MEDIUM * MAPSCALE_MODIFIER)
elseif MAPSIZE_NORMAL
	#const MAPSIZE_SIDE (MAPSIDE_NORMAL * MAPSCALE_MODIFIER)
elseif MAPSIZE_LARGE
	#const MAPSIZE_SIDE (MAPSIDE_LARGE * MAPSCALE_MODIFIER)
elseif MAPSIZE_HUGE
	#const MAPSIZE_SIDE (MAPSIDE_HUGE * MAPSCALE_MODIFIER)
elseif MAPSIZE_GIANT
	#const MAPSIZE_SIDE (MAPSIDE_GIANT * MAPSCALE_MODIFIER)
elseif MAPSIZE_MASSIVE
	#const MAPSIZE_SIDE (MAPSIDE_MASSIVE * MAPSCALE_MODIFIER)
elseif MAPSIZE_ENORMOUS
	#const MAPSIZE_SIDE (MAPSIDE_ENORMOUS * MAPSCALE_MODIFIER)
elseif MAPSIZE_COLOSSAL
	#const MAPSIZE_SIDE (MAPSIDE_COLOSSAL * MAPSCALE_MODIFIER)
elseif MAPSIZE_INCREDIBLE
	#const MAPSIZE_SIDE (MAPSIDE_INCREDIBLE * MAPSCALE_MODIFIER)
elseif MAPSIZE_MONSTROUS
	#const MAPSIZE_SIDE (MAPSIDE_MONSTREOUS * MAPSCALE_MODIFIER)
elseif MAPSIZE_LUDICROUS
	#const MAPSIZE_SIDE (MAPSIDE_LUDICROUS * MAPSCALE_MODIFIER)
endif

#const MAPSCALE_SIDE (MAPSIZE_SIDE / MAPSIDE_BASE)

/* Area Scaling */

#const MAPSIZE_AREA (MAPSIZE_SIDE * MAPSIZE_SIDE)
#const MAPSCALE_AREA (MAPSIZE_AREA / 10000)

/* Player Scaling */

if 1_PLAYER_GAME
	#const PLAYER_COUNT 1
	#define PLAYER_COUNT_ODD
elseif 2_PLAYER_GAME
	#const PLAYER_COUNT 2
	#define PLAYER_COUNT_EVEN
elseif 3_PLAYER_GAME
