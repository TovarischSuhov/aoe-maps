#includeXS ProbeMap.xs

/* Пробная карта для проверки API движка (не для игры). Результаты — в чат
   с префиксом [PRB]. Тестирует: перечисление юнитов, позиции, тайл-атрибуты,
   поддержку аурами LOS/Range/Regen, смену владения, подпись объекта,
   спавн/приказ/удаление. */

#const ARMY_TENT 1200

<PLAYER_SETUP>
random_placement
ai_info_map_type ARABIA 0 0 0

<LAND_GENERATION>
base_terrain GRASS

/* центр: якорь под два пробных тента */
create_land {
  terrain_type GRASS
  land_position 50 50
  base_size 6
  land_percent 0
  land_id 100
}

/* вода в четверти карты — точка для пробы тайл-атрибутов (25%/25%) */
create_land {
  terrain_type WATER
  land_position 25 25
  base_size 6
  land_percent 0
  set_circular_base
}

create_player_lands {
  terrain_type GRASS
  land_percent 10
  base_size 10
  circle_radius 30 5
  border_fuzziness 20
}

<OBJECTS_GENERATION>
create_object TOWN_CENTER {
  set_place_for_every_player
  min_distance_to_players 0
  max_distance_to_players 0
}

create_object VILLAGER {
  set_place_for_every_player
  min_distance_to_players 6
  max_distance_to_players 6
}

create_object SCOUT {
  set_place_for_every_player
  min_distance_to_players 7
  max_distance_to_players 9
}

/* два gaia-тента в центре: носитель ауры + цель активации рядом */
create_object ARMY_TENT {
  number_of_objects 2
  number_of_groups 1
  set_gaia_object_only
  ignore_terrain_restrictions
  set_gaia_unconvertible
  find_closest_to_map_center
  enable_tile_shuffling
  place_on_specific_land_id 100
}
