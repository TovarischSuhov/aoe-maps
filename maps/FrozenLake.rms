/* clearing at the lake center for the frost aura carrier */
create_land {
  terrain_type DIRT_MUD
  land_position 50 50
  base_size 5
  land_percent 0
  land_id 123
}

/* Player lands: circle radius grows on small maps so the home zones stay
   clear of the lake ring; on Tiny the blobs themselves shrink (1v1 splits
   land_percent 35 into ~17.5% per player — far too large for a 120-tile
   map). The lake ring must never reach the home zones. */
if TINY_MAP
create_player_lands {
  terrain_type                     GRASS_SNOW
  land_percent                     20
  base_size                        10
  circle_radius                    41 3
  border_fuzziness                 30
  other_zone_avoidance_distance    7
}
elseif SMALL_MAP
create_player_lands {
  terrain_type                     GRASS_SNOW
  land_percent                     35
  base_size                        14
  circle_radius                    43 4
  border_fuzziness                 30
  other_zone_avoidance_distance    7
}
elseif MEDIUM_MAP
create_player_lands {
  terrain_type                     GRASS_SNOW
  land_percent                     35
  base_size                        14
  circle_radius                    40 5
  border_fuzziness                 30
  other_zone_avoidance_distance    7
}
else
create_player_lands {
  terrain_type                     GRASS_SNOW
  land_percent                     35
  base_size                        14
  circle_radius                    38 5
  border_fuzziness                 30
  other_zone_avoidance_distance    7
}
endif

