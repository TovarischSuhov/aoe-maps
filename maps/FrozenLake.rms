#includeXS FrozenLake.xs

#const CENTER_ROAD_WIDTH 12
#const SHORE_WIDTH 5
#const WATER_WIDTH 5

/* Outer snow-ring radius scales with the map side (DE sizes in tiles: Tiny
   120, Small 144, Medium 168, Large 200, Huge 220, Gigantic 240, Ludikris
   480). Linear fit anchored at the play-verified Huge configuration:
   ring = ~23 + side * 0.105 (Small 38, Medium 42, Large 45, Huge 48,
   Gigantic 50, Ludikris 74). Tiny is hand-tuned (ring 30): with the default
   land_percent the 1v1 player blobs are so large they would overlap any
   ring that fits the map edge — Tiny also shrinks base_size and
   land_percent (see create_player_lands). The inner zones keep fixed
   widths: road 12, shore 5, water 5, so
   island = ring - CENTER_ROAD_WIDTH - SHORE_WIDTH - WATER_WIDTH. */
#const RING_TINY 30
#const RING_SMALL 38
#const RING_MEDIUM 42
#const RING_LARGE 45
#const RING_HUGE 48
#const RING_GIGANTIC 50
#const RING_LUDIKRIS 74

#const DIRT_MUD 76

#const ARMY_TENT 1200

<PLAYER_SETUP>
random_placement
ai_info_map_type ARABIA 0 0 0

effect_amount GAIA_SET_ATTRIBUTE WILD_PENGUIN ATTR_HITPOINTS 45
effect_amount GAIA_SET_ATTRIBUTE WILD_PENGUIN ATTR_REGENERATION_RATE 30
effect_amount GAIA_SET_ATTRIBUTE WILD_PENGUIN ATTR_ARMOR 1027

effect_amount GAIA_SET_ATTRIBUTE ARMY_TENT ATTR_HITPOINTS 9999
effect_amount GAIA_SET_ATTRIBUTE ARMY_TENT ATTR_REGENERATION_RATE 9999

effect_amount GAIA_SET_ATTRIBUTE ARMY_TENT ATTR_ARMOR 968
effect_amount GAIA_SET_ATTRIBUTE ARMY_TENT ATTR_ARMOR 1224

effect_amount GAIA_SET_ATTRIBUTE OUTPOST ATTR_LINE_OF_SIGHT 20

<LAND_GENERATION>
base_terrain SNOW_FOREST
base_layer SNOW

/* The lake scales with the map size: the outer snow-ring radius per size is
   RING_*, inner zones derive by fixed widths (12/5/5). On Tiny the ring
   reaches the player home zones — intended. */
if TINY_MAP
create_land {
  terrain_type SNOW
  land_position 50 50
  base_size RING_TINY
  land_percent 0
  set_circular_base
  border_fuzziness 10
  zone 111
  land_id 111
}
create_land {
  terrain_type ICYSHORE
  land_position 50 50
  base_size (RING_TINY - CENTER_ROAD_WIDTH)
  land_percent 0
  set_circular_base
}
create_land {
  terrain_type WATER
  land_position 50 50
  base_size (RING_TINY - CENTER_ROAD_WIDTH - SHORE_WIDTH)
  land_percent 0
  set_circular_base
}
create_land {
  terrain_type DLC_FORESTSNOWAUTUMN
  land_position 50 50
  base_size (RING_TINY - CENTER_ROAD_WIDTH - SHORE_WIDTH - WATER_WIDTH)
  land_percent 0
  set_circular_base
}
elseif SMALL_MAP
