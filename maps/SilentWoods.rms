/* Cave tents: one indestructible gaia army tent per cave land,
   gated by the same player-count triples as the lands. Buildings are dat
   type 80 - the only gaia buildings on the map, hence the enumerable
   wolf-spawn anchors. */
create_object ARMY_TENT {
	number_of_objects 1
	set_gaia_object_only
	ignore_terrain_restrictions
	set_gaia_unconvertible
	find_closest
	enable_tile_shuffling
	place_on_specific_land_id 201
	make_indestructible
}
