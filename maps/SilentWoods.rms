#includeXS SilentWoods.xs

/* SilentWoods - open temperate-woods map with a day/night cycle.
   Nights: dark color mood + wolf packs emerging from cave rocks on hills.
   This file is assembled in parts; see docs/silentwoods-review.md for the
   open questions and the in-game verification plan. */

#const ARMY_TENT 1200 /* FrozenLake-style gaia tent - the cave anchor building */
#const PLACEHOLDER_INVISIBLE 1543 /* on-grid placeholder, alternative to 1902 */

<PLAYER_SETUP>
random_placement
ai_info_map_type ARABIA 0 0 0

/* Night wolves: boosted sight so the packs spot villagers from the caves.
   The spawns are Arctic Wolf (1965) - the confirmed wolf id in game; the
   classic WOLF constant resolved to a villager-like unit via xsCreateUnit. */
effect_amount GAIA_SET_ATTRIBUTE ARCTIC_WOLF ATTR_LINE_OF_SIGHT 12

/* DE map sizes (side in tiles): Tiny 120, Small 144, Medium 168, Large 200,
   Huge 220, Gigantic 240, Ludikris 480. Fixed-count blocks multiply by
   SIZE_FACTOR below; percent-based blocks (forests) scale on their own.
   Lives inside PLAYER_SETUP: after #includeXS the LSP rejects a bare
   top-level if (see docs/lsp-issues.md), and this section ordering keeps
   SIZE_FACTOR defined before the later sections use it. */
if TINY_MAP
	#const SIZE_FACTOR 1
	#const CAVE_HILL_R 4
	#const DEER_GROUPS 1
elseif SMALL_MAP
	#const SIZE_FACTOR 2
	#const CAVE_HILL_R 4
	#const DEER_GROUPS 1
elseif MEDIUM_MAP
	#const SIZE_FACTOR 3
	#const CAVE_HILL_R 4
	#const DEER_GROUPS 2
elseif LARGE_MAP
	#const SIZE_FACTOR 4
	#const CAVE_HILL_R 4
	#const DEER_GROUPS 2
elseif HUGE_MAP
	#const SIZE_FACTOR 5
	#const CAVE_HILL_R 4
	#const DEER_GROUPS 3
elseif GIGANTIC_MAP
	#const SIZE_FACTOR 6
	#const CAVE_HILL_R 5
	#const DEER_GROUPS 3
else /* LUDIKRIS_MAP */
	#const SIZE_FACTOR 24
	#const CAVE_HILL_R 6
	#const DEER_GROUPS 4
endif

/* Player count as a numeric const (math expressions need numbers, not
   condition labels). */
if 1_PLAYER_GAME
	#const PLAYER_COUNT 1
elseif 2_PLAYER_GAME
	#const PLAYER_COUNT 2
elseif 3_PLAYER_GAME
	#const PLAYER_COUNT 3
elseif 4_PLAYER_GAME
	#const PLAYER_COUNT 4
elseif 5_PLAYER_GAME
	#const PLAYER_COUNT 5
elseif 6_PLAYER_GAME
	#const PLAYER_COUNT 6
elseif 7_PLAYER_GAME
	#const PLAYER_COUNT 7
else /* 8 players */
	#const PLAYER_COUNT 8
endif

/* Player-count flags for the cave triples (three cave hills per player:
   gold, stone, gold). Conditions accept only a single label (no
   comparisons in RMS), so every bigger lobby additionally defines the
   next triple flag. */
if 1_PLAYER_GAME
elseif 2_PLAYER_GAME
	#define P_C6
elseif 3_PLAYER_GAME
	#define P_C6
	#define P_C9
elseif 4_PLAYER_GAME
	#define P_C6
	#define P_C9
	#define P_C12
elseif 5_PLAYER_GAME
	#define P_C6
	#define P_C9
	#define P_C12
	#define P_C15
elseif 6_PLAYER_GAME
	#define P_C6
	#define P_C9
	#define P_C12
	#define P_C15
	#define P_C18
elseif 7_PLAYER_GAME
	#define P_C6
	#define P_C9
	#define P_C12
	#define P_C15
	#define P_C18
	#define P_C21
else /* 8 players */
	#define P_C6
	#define P_C9
	#define P_C12
	#define P_C15
	#define P_C18
	#define P_C21
	#define P_C24
endif

<LAND_GENERATION>
base_terrain GRASS

/* Player starts: grass blobs raised one elevation step - starts on hills. */
create_player_lands
{
	terrain_type GRASS
	number_of_tiles 1400
	base_size 16
	base_elevation 3
	clumping_factor 15
	other_zone_avoidance_distance 2
}

/* Cave hills: three per player (gold, stone, gold), gated by the
   player-count triple flags (P_C* from PLAYER_SETUP). Each hilltop has a
   small dark dirt cap and carries a rock with a 3-tile pile
   (OBJECTS_GENERATION, land_id 201..224). Raised one step above the
   player starts; hill radius is compact (CAVE_HILL_R). */
create_land
{
	terrain_type DIRT
	base_size CAVE_HILL_R
	land_percent 0
	base_elevation 4
	set_circular_base
	other_zone_avoidance_distance 12
	zone 201
	land_id 201
}
create_land
{
	terrain_type DIRT
	base_size CAVE_HILL_R
	land_percent 0
	base_elevation 4
	set_circular_base
	other_zone_avoidance_distance 12
	zone 202
	land_id 202
}
