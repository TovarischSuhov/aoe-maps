<ELEVATION_GENERATION>
/* Scattered hills one step above ground over the whole map; balanced
   placement keeps clumps off the (already raised) player starts. */
create_elevation 4
{
	enable_balanced_elevation
	base_terrain GRASS
	number_of_tiles (1300 * SIZE_FACTOR)
	number_of_clumps (36 * SIZE_FACTOR)
}

<TERRAIN_GENERATION>
/* Open woods: forest arrives in patches, kept away from the starts. */
create_terrain FOREST
{
	base_terrain GRASS
	land_percent 20
	number_of_clumps 20
	set_scale_by_groups
	set_avoid_player_start_areas
	spacing_to_other_terrain_types 6
}

/* Scattered single trees everywhere to sell the "open woods" look. */
create_terrain FOREST
{
	base_terrain GRASS
	number_of_tiles 64
	number_of_clumps 3
	clumping_factor rnd(20, 40)
	set_scale_by_groups
	set_avoid_player_start_areas
	spacing_to_other_terrain_types 6
}

/* Cosmetic ground variety. No DIRT here on purpose: the cave hill caps
   must stay the only DIRT terrain on the map, so cave piles can never
   drift off the cave hills (terrain_to_place_on DIRT). */
create_terrain GRASS2
{
	base_terrain GRASS
	land_percent 6
	number_of_clumps 20
	set_scale_by_groups
	terrain_mask 1
}
create_terrain GRASS3
{
	base_terrain GRASS
	land_percent 4
	number_of_clumps 14
	set_scale_by_groups
	terrain_mask 1
}

<OBJECTS_GENERATION>
/* Default starting units (the engine does not place them itself). */
create_object TOWN_CENTER {
	set_place_for_every_player
	max_distance_to_players 0
	min_distance_to_players 0
}

create_object VILLAGER {
	set_place_for_every_player
	max_distance_to_players 6
	min_distance_to_players 6
}

create_object SCOUT {
	set_place_for_every_player
	min_distance_to_players 7
	max_distance_to_players 9
}

/* regicide config */
if REGICIDE
create_object KING {
	set_place_for_every_player
	min_distance_to_players 6
	max_distance_to_players 6
}

create_object HOUSE {
	set_place_for_every_player
	max_distance_to_players 8
	min_distance_to_players 8
}
endif

/* Starting resources, standard set (block style borrowed from FrozenLake).
   Every pile below is player-anchored. The neutral (map-wide) gold and
   stone are NOT scattered: they live on the cave hills only (part 3),
   caves being the expansion targets. */
create_object FORAGE {
	set_place_for_every_player
	set_gaia_object_only
	number_of_objects 6
	number_of_groups 1
	set_tight_grouping
	min_distance_to_players 10
	max_distance_to_players 14
	set_circular_placement
	min_distance_group_placement 7
	resource_delta rnd(-20, 20)
	terrain_to_place_on GRASS
	find_closest
	enable_tile_shuffling
	require_path 1
}

/* Main gold */
create_object GOLD {
	number_of_objects 7
	number_of_groups 1
	set_place_for_every_player
	set_tight_grouping
	set_gaia_object_only
	min_distance_to_players 12
	max_distance_to_players 16
	set_circular_placement
	min_distance_group_placement 8
	resource_delta rnd(-100, 100)
	terrain_to_place_on GRASS
	find_closest
	enable_tile_shuffling
	require_path 1
}

