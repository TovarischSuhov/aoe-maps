/* Neutral deer packs: DEER_GROUPS loose groups per player (scales with
   the map size), scattered map-wide. */
create_object DEER {
	number_of_objects 4
	number_of_groups DEER_GROUPS
	set_scaling_to_player_number
	set_gaia_object_only
	set_loose_grouping
	min_distance_to_players 26
	set_circular_placement
	min_distance_group_placement 10
	resource_delta rnd(-20, 20)
	terrain_to_place_on GRASS
	find_closest
	enable_tile_shuffling
	require_path 1
}

/* Relics: five in a 1v1 (standard Arabia counts and spacing, corpus
   038__Arabia.rms), +1 per extra player; terrain/path constraints make
   them reachable. */
create_object RELIC {
	number_of_objects (3 + PLAYER_COUNT)
	set_gaia_object_only
	min_distance_to_players 25
	temp_min_distance_group_placement 20
	terrain_to_place_on GRASS
	find_closest
	enable_tile_shuffling
	require_path 1
}

/* Scattered cave hills (lands 201..224): a mossy rock on the dirt cap
   with a fixed 3-tile pile beside it, triple per player - gold, stone,
   gold. These are the only neutral gold/stone sources on the map. */
