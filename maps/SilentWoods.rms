/* Home cave: ONE rock per player in the far-gold band (22-28) - every
   Mossy Rock is a wolf-spawning cave in XS, so the old 3-rock cluster
   would mean three packs at home. ignore_terrain_restrictions: the rock
   is tree-class and was silently dropped on GRASS without it. The rock
   reserves actor_area 402; the home outpost is placed INTO that area
   (buildings respect actor areas - the official barracks/house pattern),
   so the tower stands right at the cave rock. */
create_object ROCK_MOSSY {
	set_place_for_every_player
	set_gaia_object_only
	number_of_objects 1
	min_distance_to_players 22
	max_distance_to_players 28
	find_closest
	enable_tile_shuffling
	require_path 1
	ignore_terrain_restrictions
	actor_area 402
	actor_area_radius 3
}
/* Home cave tent: per player, placed inside the home rock's area.
   set_gaia_unconvertible is REQUIRED here like on the scattered ones -
   without it monks can convert the tower (in-game finding, 2026-11-21). */
create_object ARMY_TENT {
	set_place_for_every_player
	set_gaia_object_only
	number_of_objects 1
	actor_area_to_place_in 402
	find_closest
	require_path 1
	ignore_terrain_restrictions
	set_gaia_unconvertible
	make_indestructible
}
