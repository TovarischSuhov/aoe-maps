/* StandartNomadRandom.rms — случайная «номадские» карта из стандартного пула AoE2: DE.
 *
 * Сгенерировано tools/generate-specialized.mjs из resources/_common/dat/maps.json
 * (2026-11-18). Пул: style=random, все карты с флагом nomad из maps.json
 * (пересечения допустимы: карта с несколькими флагами играет в нескольких
 * подборках).
 * Исключены: megarandom, EM* (quickplay/Empire Wars), CtR* (Capture the Relic).
 *
 * Карты не копируются: каждая подключается из установки игры через
 * #include_drs (резолв по имени из resources/_common/drs/gamedata_x2/).
 * percent_chance — эксклюзивный выбор, сумма ровно 100: одна карта на партию
 * гарантирована (идиом официальных скриптов — Arabia.rms, MegaRandom.rms2).
 * В пуле 14 карт; доли 7–8% разбросаны равномерно.
 */

start_random
	percent_chance 7 #define PICK_001
	percent_chance 7 #define PICK_002
	percent_chance 7 #define PICK_003
	percent_chance 8 #define PICK_004
	percent_chance 7 #define PICK_005
	percent_chance 7 #define PICK_006
	percent_chance 7 #define PICK_007
	percent_chance 7 #define PICK_008
	percent_chance 7 #define PICK_009
	percent_chance 7 #define PICK_010
	percent_chance 8 #define PICK_011
	percent_chance 7 #define PICK_012
	percent_chance 7 #define PICK_013
	percent_chance 7 #define PICK_014
end_random

if PICK_001
	#include_drs nomad.rms
elseif PICK_002
	#include_drs Pilgrims.rms
elseif PICK_003
	#include_drs Shipwreck.rms
elseif PICK_004
	#include_drs steppe.rms2
elseif PICK_005
	#include_drs "Mountain Pass.rms"
elseif PICK_006
	#include_drs "Nile Delta.rms"
elseif PICK_007
	#include_drs Water_Nomad.rms
elseif PICK_008
	#include_drs Bogland.rms
elseif PICK_009
	#include_drs LandNomad.rms
elseif PICK_010
	#include_drs AfricanClearing.rms
elseif PICK_011
	#include_drs Graupel.rms
elseif PICK_012
	#include_drs Stranded.rms
elseif PICK_013
	#include_drs Mired.rms
elseif PICK_014
	#include_drs Murkwood.rms
endif
